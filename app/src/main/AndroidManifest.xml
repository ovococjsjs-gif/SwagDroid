<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Разрешения для локального поиска порта Беспроводной отладки (_adb-tls-pairing._tcp / _adb-tls-connect._tcp) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Для уведомления с вводом 6-значного кода сопряжения (RemoteInput) и автостарта при загрузке -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Выдаётся автоматически самим swagdroid_server при первом старте для бесшовного автозапуска после ребута -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".SwagDroidApplication"
        android:allowBackup="false"
        android:label="SwagDroid"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ContentProvider-приёмник живого IBinder от демона swagdroid_server (uid=2000 или uid=0) -->
        <provider
            android:name=".ipc.BinderContainerProvider"
            android:authorities="com.swagdroid.app.binder.provider"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <!-- Опциональный провайдер для моста с установленным Shizuku -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Сервис сопряжения со шторкой RemoteInput -->
        <service
            android:name="com.swagdroid.adb.AdbPairingForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- Приёмник честного автозапуска после перезагрузки при появлении Wi-Fi -->
        <receiver
            android:name="com.swagdroid.adb.AdbBootAutoStarter"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
